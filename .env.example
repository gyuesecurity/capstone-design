# 로컬 개발에서만 true로 설정하면 data/keys 아래에 개발 키를 자동 생성합니다.
EVIDENCE_ALLOW_DEV_KEY_GENERATION=false
EVIDENCE_KEY_VERSION=v1
# 운영·시연은 Docker secret 또는 저장소 밖의 키링 파일 경로를 사용하세요.
EVIDENCE_MASTER_KEYS_FILE=/run/secrets/evidence_master_keys
# 컨테이너를 사용하지 않는 개발 환경에서는 아래 JSON 환경변수를 대신 사용할 수 있습니다.
# EVIDENCE_MASTER_KEYS={"v1":"REPLACE_WITH_32_BYTE_URLSAFE_BASE64_KEY"}
EVIDENCE_DATA_DIR=./data
