# ------------------------------------------------------------
# 환경변수 견본 파일 (.env.example)
#
# 사용 방법
#   1. 이 파일을 복사해서 같은 위치에 .env 파일을 만듭니다.
#   2. .env 파일에만 실제 값을 입력합니다.
#   3. .env 파일은 .gitignore에 의해 GitHub에 올라가지 않습니다.
#
# 주의
#   - 이 견본 파일에는 실제 비밀번호, 암호화 키, API 키를 절대 적지 않습니다.
#   - 이 저장소에는 아직 서버 코드가 없습니다(0단계).
#     서버 코드는 1단계에서 프론트엔드 프로젝트에 있던 기존 server/main.py를 가져올 예정입니다.
#   - 그 기존 코드는 .env 파일을 자동으로 읽지 않고 운영체제 환경변수만 읽습니다.
#     .env 읽기 기능은 1단계 이후에 추가할 예정입니다.
# ------------------------------------------------------------

# [1단계에서 가져올 기존 코드가 사용] 증거 파일과 SQLite DB를 저장할 폴더
# 기존 server/main.py가 읽는 변수입니다. 비워 두면 프로젝트의 data/ 폴더를 사용합니다.
EVIDENCE_DATA_DIR=

# [1단계 예정] API 호출을 허용할 프론트엔드 주소 (CORS)
# 여러 개는 쉼표로 구분합니다. 예: http://127.0.0.1:5500,http://localhost:5500
EVIDENCE_CORS_ORIGINS=

# [6단계 예정] 증거 파일 암호화에 쓰는 마스터 키
# 실제 키는 .env 파일에만 넣고, 생성 방법은 6단계에서 안내합니다.
# 이 줄은 반드시 비워 둔 상태로 저장소에 올립니다.
EVIDENCE_MASTER_KEY=
